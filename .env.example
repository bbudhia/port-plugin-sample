# Copy to .env and fill in.
# Local dev only — used by SimulatePort.tsx (npm run dev). Never commit real values.

# Option 1: static token — Port profile → Credentials → Generate API token
PORT_DEV_TOKEN=

# Option 2: client credentials — fetches a token via POST /v1/auth/access_token on startup.
# Takes precedence over PORT_DEV_TOKEN when both CLIENT_ID and CLIENT_SECRET are set.
# Port portal: Settings → Credentials → Client credentials
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=

PORT_DEV_BLUEPRINT_ID=your-blueprint-identifier
PORT_DEV_ENTITY_IDENTIFIER=your-entity-identifier

# Optional — override the dev API base URL. Leave unset to use the page origin
# (webpack devServer proxies /v1/* to the Port API). Never set app.getport.io here.
# PORT_DEV_API_BASE_URL=http://localhost:9000

# Port API region for the dev proxy (default: eu). Set to "us" for US tenants.
# PORT_REGION=us